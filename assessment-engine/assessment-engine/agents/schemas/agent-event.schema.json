{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vervenveda.com/assessment-engine/agents/schemas/agent-event.schema.json",
  "title": "Verve Agent Event",
  "type": "object",
  "required": ["id", "schemaVersion", "type", "sourceApp", "learnerId", "occurredAt", "formalGradeEligible"],
  "properties": {
    "id": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "type": { "enum": ["agent.decision", "agent.outcome", "agent.memory-reset"] },
    "sourceApp": { "type": "string" },
    "learnerId": { "type": "string" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "formalGradeEligible": { "type": "boolean", "const": false },
    "problemId": { "type": ["string", "null"] },
    "domainId": { "type": ["string", "null"] },
    "strategy": { "type": ["string", "null"] },
    "selectedActionId": { "type": ["string", "null"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "elapsedMs": { "type": "number", "minimum": 0 }
  },
  "additionalProperties": true
}
