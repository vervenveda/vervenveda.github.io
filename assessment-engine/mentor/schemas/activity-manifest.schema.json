{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vervenveda.com/assessment-engine/mentor/schemas/activity-manifest.schema.json",
  "title": "Khaemenes Mentor Repository Manifest",
  "type": "object",
  "required": [
    "version",
    "sourceId",
    "name",
    "mentorSearchable",
    "resources"
  ],
  "properties": {
    "version": {
      "type": [
        "integer",
        "string"
      ]
    },
    "sourceId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "classification": {
      "type": "string"
    },
    "mentorSearchable": {
      "type": "boolean"
    },
    "audiences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "homepage": {
      "type": "string"
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "audiences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "minutes": {
            "type": "number",
            "minimum": 1,
            "maximum": 240
          },
          "energy": {
            "type": "string"
          },
          "mentorEligible": {
            "type": "boolean"
          },
          "featured": {
            "type": "boolean"
          },
          "classification": {
            "type": "string"
          },
          "explicitAdultOptIn": {
            "type": "boolean"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}