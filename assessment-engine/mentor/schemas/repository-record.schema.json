{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vervenveda.com/assessment-engine/mentor/schemas/repository-record.schema.json",
  "title": "Discovered Repository Record",
  "type": "object",
  "required": [
    "id",
    "owner",
    "name",
    "fullName",
    "classification",
    "discoveryStatus",
    "recommendable"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "fullName": {
      "type": "string"
    },
    "classification": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "discoveryStatus": {
      "type": "string"
    },
    "recommendable": {
      "type": "boolean"
    },
    "manifest": {
      "type": "object"
    }
  },
  "additionalProperties": true
}